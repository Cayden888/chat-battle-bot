# ===== 必填 =====
BOT_TOKEN=123456:ABC-xxxx                 # BotFather 给的 token
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...               # Supabase → Settings → API → service_role（不要外泄）
GROUP_IDS=-1001234567890                  # 活动的中文群 chat_id，多个用逗号隔开
CS_CHAT_ID=-1009876543210                 # 客服群：周一 11AM 收 Top20 名单 + CSV
LOG_CHAT_ID=                              # 选填：违规报告同时发一份到这个群

# ===== 选填（括号内是默认值）=====
REVIEWER_IDS=8875069703                   # 违规审核人员（@nicolenicola），多个用逗号隔开
ADMIN_IDS=                                # 额外管理员 user_id，群管理员自动算
TZ_NAME=Asia/Kuala_Lumpur
ROLLOVER_TIME=10:30                       # 每周一几点换期（统计截止）
REPORT_TIME=11:00                         # 每周一几点发名单
TOP_N=20
PRIZE_TEXT=RM8.8
TURNOVER_REQ=1000
MIN_INTERVAL_SEC=3                        # 两条有效发言最少间隔（防刷屏）
NEWBIE_THRESHOLD=5                        # 历史有效发言少于这个数又发Link = 报告里标注「疑似钓鱼」
QR_CHECK=1                                # 1=检查图片里的二维码
